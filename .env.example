# Shared by the bot and API (copy to .env at the repo root).

# From @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenHere

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role secret only — never commit or ship to the Mini App
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# API
PORT=3000

# Optional: production Mini App origin for CORS (localhost always allowed)
# FRONTEND_ORIGIN=https://your-mini-app.example.com

# Optional: HTTPS Mini App URL (Cloudflare tunnel / Netlify).
# Adds a "📈 Dashboard" button on the bot keyboard that opens the Mini App.
# MINIAPP_URL=https://your-tunnel-or-netlify-url.example.com
