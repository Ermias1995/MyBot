# Telegram bot token - from @BotFather in Telegram (/newbot, then copy the token).
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenHere

# Supabase -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key (secret!). It bypasses row level security, so it must
# only ever run on your own machine/server - never commit it or ship it to a client.
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...