{
  "name": "expense-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Telegram expense tracker — bot + Mini App + API",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev -w @expense/bot",
    "dev:api": "npm run dev -w @expense/api",
    "dev:web": "npm run dev -w @expense/miniapp",
    "start:bot": "npm run start -w @expense/bot",
    "start:api": "npm run start -w @expense/api",
    "build:web": "npm run build -w @expense/miniapp",
    "test:init-data": "npm run test:init-data -w @expense/api"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@expense/api": "*",
    "@expense/db": "*"
  }
}
