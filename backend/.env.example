# Same token the bot uses (@BotFather -> /mybots -> your bot -> API Token).
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenHere

# Port the Express API listens on.
PORT=3000

# Optional for now: the exact origin (scheme + host [+ port]) the future
# React Mini App will be served from. Until it is set, CORS only allows
# localhost development origins. Example:
# FRONTEND_ORIGIN=https://my-mini-app.example.com